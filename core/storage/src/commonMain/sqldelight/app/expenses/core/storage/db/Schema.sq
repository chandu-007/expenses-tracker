-- Current state: one row per entity, with indexed columns for fast reports and search.
CREATE TABLE account (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    currency TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    -- What the account held before its first entry here (negative: owed on a card or loan).
    opening_minor INTEGER NOT NULL DEFAULT 0,
    -- Hidden from pickers. Its history stays and still counts.
    archived INTEGER NOT NULL DEFAULT 0
);

-- Decimal places per currency code (INR 2, JPY 0, KWD 3), recorded the first time a currency is saved so any
-- currency works without a hard-coded list.
CREATE TABLE currency (
    code TEXT NOT NULL PRIMARY KEY,
    digits INTEGER NOT NULL
);

-- Categories form a tree one level deep. The id never changes, so renaming does not touch any entry; entries refer to
-- categories by id (entry_split.category_id, spend_line.category_id, entry.category_id for income, template.category_id).
CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    parent_id TEXT,
    color INTEGER,
    position INTEGER NOT NULL,
    hidden INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER NOT NULL DEFAULT 0,
    -- Set when this category was merged into another. The row stays as a tombstone so an edit that arrives later and still
    -- uses this id (for example from a device that had not yet seen the merge) is redirected to the target.
    merged_into TEXT
);

-- One-tap entries ("Chai 20, Cash"). A null amount means the template fills category, account and note and asks for the amount.
-- uses only orders the list on this device; it is not logged for sync.
CREATE TABLE template (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    amount_minor INTEGER,
    currency TEXT NOT NULL,
    category_id TEXT NOT NULL,
    account_id TEXT NOT NULL,
    merchant TEXT,
    uses INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Spending limits. scope is '' for the overall cap, otherwise the id of the category the limit applies to.
CREATE TABLE budget (
    scope TEXT NOT NULL PRIMARY KEY,
    limit_minor INTEGER NOT NULL CHECK (limit_minor > 0),
    currency TEXT NOT NULL
);

-- How time is cut into budget periods: one row. kind is 'monthly' (start_value = start day 1..28) or 'weekly' (start_value = ISO weekday, 1 = Monday).
CREATE TABLE budget_period (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    kind TEXT NOT NULL,
    start_value INTEGER NOT NULL
);

-- Repeating expenses. A null amount means "ask me each time". start_day is days since 1970-01-01. end_kind is 'never', 'date'
-- (end_value = last day) or 'count' (end_value = number of occurrences). auto = 1 posts without asking.
CREATE TABLE recurring (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    amount_minor INTEGER,
    currency TEXT NOT NULL,
    category_id TEXT NOT NULL,
    account_id TEXT NOT NULL,
    merchant TEXT,
    unit TEXT NOT NULL,
    every INTEGER NOT NULL,
    start_day INTEGER NOT NULL,
    end_kind TEXT NOT NULL,
    end_value INTEGER,
    auto INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER NOT NULL DEFAULT 0,
    kind TEXT NOT NULL DEFAULT 'EXPENSE',
    to_account_id TEXT
);

-- Occurrences that were dealt with, by due date (days since 1970-01-01), so editing a schedule never re-posts or forgets one.
CREATE TABLE recurring_done (
    recurring_id TEXT NOT NULL,
    day INTEGER NOT NULL,
    outcome TEXT NOT NULL,
    entry_id TEXT,
    PRIMARY KEY (recurring_id, day)
);

-- Small device-local preferences, such as the last category and account used. Never synced.
CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- seq is a stable integer key (survives VACUUM) so the full-text index can point at rows safely.
CREATE TABLE entry (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    id TEXT NOT NULL UNIQUE,
    kind TEXT NOT NULL,
    occurred_at INTEGER NOT NULL,
    account_id TEXT,
    counter_account_id TEXT,
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL,
    category_id TEXT,
    -- Columns below are used only by some kinds; see EntryMapping.kt for which.
    person_id TEXT,
    to_amount_minor INTEGER,
    to_currency TEXT,
    direction TEXT,
    refunds_entry TEXT,
    original_amount_minor INTEGER,
    original_currency TEXT,
    merchant TEXT,
    note TEXT,
    source TEXT NOT NULL DEFAULT 'manual',
    source_ref TEXT,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- (occurred_at, seq) is a total order, so lists and pages never repeat or skip rows that share a timestamp.
CREATE INDEX entry_time ON entry(occurred_at DESC, seq DESC) WHERE deleted = 0;
CREATE INDEX entry_account_time ON entry(account_id, occurred_at DESC) WHERE deleted = 0;
-- Account balances read only these two indexes (no table rows), so the home screen's balances stay cheap on a big ledger.
CREATE INDEX entry_account_sums ON entry(account_id, kind, direction, amount_minor) WHERE deleted = 0;
CREATE INDEX entry_transfer_in ON entry(counter_account_id, to_amount_minor) WHERE kind = 'TRANSFER' AND deleted = 0;
CREATE INDEX entry_refunds ON entry(refunds_entry) WHERE refunds_entry IS NOT NULL;
-- What each person owes comes from this index alone, so the lent-and-borrowed screen stays cheap on a big ledger.
CREATE INDEX entry_loans ON entry(person_id, currency, direction, amount_minor, occurred_at) WHERE kind = 'SETTLEMENT' AND deleted = 0;
CREATE INDEX entry_deleted_ids ON entry(id) WHERE deleted = 1;
CREATE UNIQUE INDEX entry_source_ref ON entry(source, source_ref) WHERE source_ref IS NOT NULL;

-- Category splits and shared-expense shares of an entry, in their original order.
CREATE TABLE entry_split (
    entry_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    category_id TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    PRIMARY KEY (entry_id, position)
);

CREATE INDEX entry_split_category ON entry_split(category_id);
-- Income entries carry a category directly; this keeps "how many things use this category" fast on a large ledger.
CREATE INDEX entry_income_category ON entry(category_id) WHERE category_id IS NOT NULL;

CREATE TABLE entry_share (
    entry_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    person_id TEXT, -- null is the user
    amount_minor INTEGER NOT NULL,
    PRIMARY KEY (entry_id, position)
);

-- Someone the person lends to, borrows from or settles with. An entry refers to one by [id] (entry.person_id); the name lives only here.
CREATE TABLE person (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- A photo or file attached to an entry. The bytes live in a file on the phone named by id; this row says whose it is and what it is.
CREATE TABLE attachment (
    id TEXT NOT NULL PRIMARY KEY,
    entry_id TEXT NOT NULL,
    name TEXT NOT NULL,
    mime TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    sha256 TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE INDEX attachment_entry ON attachment(entry_id);

-- Transactions found in texts or notifications, waiting for the person to confirm them. Never part of the ledger until confirmed.
-- [body] is kept only while the item is pending, so it can be checked against what was parsed; it is cleared when the item is resolved.
-- [fingerprint] makes capture idempotent: the same text delivered twice is one item.
CREATE TABLE inbox (
    id TEXT NOT NULL PRIMARY KEY,
    source TEXT NOT NULL,
    sender TEXT NOT NULL,
    issuer TEXT NOT NULL,
    received_at INTEGER NOT NULL,
    direction TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL,
    txn_date TEXT,
    reference TEXT,
    account_last4 TEXT,
    via_upi INTEGER NOT NULL DEFAULT 0,
    confidence TEXT NOT NULL,
    body TEXT,
    status TEXT NOT NULL DEFAULT 'PENDING',
    entry_id TEXT,
    fingerprint TEXT NOT NULL UNIQUE
);
CREATE INDEX inbox_status ON inbox(status, received_at DESC);

-- Bills found in texts and notifications (a card statement, an electricity bill, an EMI falling due). FOUND waits for the person to add it, TRACKED is being watched
-- until it is paid, PAID is done, DISMISSED was skipped. The text is kept only while FOUND, like the inbox. [dedupe_key] makes capture idempotent: the same bill
-- reminded again (same biller, card or consumer, due date and amount) is one row in any state, so a bill the person skipped does not come back.
CREATE TABLE bill (
    id TEXT NOT NULL PRIMARY KEY,
    source TEXT NOT NULL,
    sender TEXT NOT NULL,
    issuer TEXT NOT NULL,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    min_due_minor INTEGER,
    currency TEXT NOT NULL,
    due_date TEXT,
    account_last4 TEXT,
    reference TEXT,
    auto_debit INTEGER NOT NULL DEFAULT 0,
    received_at INTEGER NOT NULL,
    body TEXT,
    status TEXT NOT NULL DEFAULT 'FOUND',
    entry_id TEXT,
    paid_at INTEGER,
    dedupe_key TEXT NOT NULL UNIQUE
);
CREATE INDEX bill_status ON bill(status, due_date);

-- The person's own rules for captured transactions, in the order they are tried, and what they chose for each payee last time.
CREATE TABLE capture_rule (
    id TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    pattern TEXT NOT NULL,
    category_id TEXT NOT NULL
);
CREATE TABLE merchant_map (
    key TEXT NOT NULL PRIMARY KEY,
    category_id TEXT NOT NULL,
    uses INTEGER NOT NULL DEFAULT 1
);

-- One row per text looked at, without its words: when, which header root, what was decided. Capture health reads it; it is pruned to 90 days.
CREATE TABLE capture_event (
    at INTEGER NOT NULL,
    sender_root TEXT NOT NULL,
    outcome TEXT NOT NULL
);
CREATE INDEX capture_event_at ON capture_event(at);

-- How a credit card bills: the day the statement is cut and the day payment is due (see CardTerms in the domain).
CREATE TABLE card_terms (
    account_id TEXT NOT NULL PRIMARY KEY,
    statement_day INTEGER NOT NULL,
    due_day INTEGER NOT NULL,
    min_due_percent INTEGER NOT NULL DEFAULT 5,
    remind_days INTEGER NOT NULL DEFAULT 3
);

-- A search the user keeps under a name. Dates are relative ("last 30 days"), so it stays useful tomorrow.
CREATE TABLE saved_search (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    text TEXT NOT NULL DEFAULT '',
    min_rupees TEXT NOT NULL DEFAULT '',
    max_rupees TEXT NOT NULL DEFAULT '',
    category_id TEXT,
    kind TEXT NOT NULL DEFAULT 'ANY',
    range_kind TEXT NOT NULL DEFAULT 'ANY',
    tag TEXT,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Tags: many per entry, compared ignoring case. The first spelling used for a tag is the one every entry keeps (the store looks it up).
CREATE TABLE entry_tag (
    entry_id TEXT NOT NULL,
    tag TEXT NOT NULL COLLATE NOCASE,
    PRIMARY KEY (entry_id, tag)
) WITHOUT ROWID;

CREATE INDEX entry_tag_tag ON entry_tag(tag, entry_id);

-- Signed spending per category for every live entry, written by the repository from the same domain code the
-- in-memory ledger uses (SpendLines), so SQL reports and the ledger cannot disagree. Refunds are negative lines.
-- Covered by spend_line_report, so totals never touch other tables. The earlier design summed entry rows
-- directly; that was wrong for split, shared and refunded entries.
CREATE TABLE spend_line (
    entry_id TEXT NOT NULL,
    line INTEGER NOT NULL,
    occurred_at INTEGER NOT NULL,
    currency TEXT NOT NULL,
    category_id TEXT,
    mine_minor INTEGER NOT NULL,
    cash_out_minor INTEGER NOT NULL,
    PRIMARY KEY (entry_id, line)
);

CREATE INDEX spend_line_report ON spend_line(currency, occurred_at, category_id, mine_minor, cash_out_minor);

-- Full-text index over merchant and note. The trigram tokenizer gives case-insensitive substring
-- matching for queries of 3+ characters; shorter queries use searchShort. Kept in sync by triggers.
CREATE VIRTUAL TABLE entry_fts USING fts5(merchant, note, content='entry', content_rowid='seq', tokenize='trigram');

-- While a row exists here the triggers below do nothing; bulk loads suspend indexing and rebuild once at the end.
-- It lives in the database, so a failed bulk load rolls the flag back together with its rows.
CREATE TABLE fts_suspended (id INTEGER NOT NULL PRIMARY KEY);

CREATE TRIGGER entry_fts_insert AFTER INSERT ON entry
WHEN NOT EXISTS (SELECT 1 FROM fts_suspended)
BEGIN
    INSERT INTO entry_fts(rowid, merchant, note) VALUES (new.seq, new.merchant, new.note);
END;

CREATE TRIGGER entry_fts_delete AFTER DELETE ON entry
WHEN NOT EXISTS (SELECT 1 FROM fts_suspended)
BEGIN
    INSERT INTO entry_fts(entry_fts, rowid, merchant, note) VALUES ('delete', old.seq, old.merchant, old.note);
END;

CREATE TRIGGER entry_fts_update AFTER UPDATE OF merchant, note ON entry
WHEN NOT EXISTS (SELECT 1 FROM fts_suspended)
BEGIN
    INSERT INTO entry_fts(entry_fts, rowid, merchant, note) VALUES ('delete', old.seq, old.merchant, old.note);
    INSERT INTO entry_fts(rowid, merchant, note) VALUES (new.seq, new.merchant, new.note);
END;

suspendFts:
INSERT OR IGNORE INTO fts_suspended(id) VALUES (1);

resumeFts:
DELETE FROM fts_suspended;


-- Append-only log of field-level changes, ordered by hybrid logical clock. Sync (phase 3) ships this log.
-- Last write wins per (entity, row_id, field) by the highest hlc.
CREATE TABLE op_log (
    hlc TEXT NOT NULL PRIMARY KEY,
    entity TEXT NOT NULL,
    row_id TEXT NOT NULL,
    field TEXT NOT NULL,
    value TEXT
);

CREATE INDEX op_log_row ON op_log(entity, row_id, field, hlc DESC);

insertAccount:
INSERT INTO account(id, name, type, currency, deleted, opening_minor, archived) VALUES (?, ?, ?, ?, 0, ?, ?)
ON CONFLICT(id) DO UPDATE SET name = excluded.name, type = excluded.type, currency = excluded.currency,
    opening_minor = excluded.opening_minor, archived = excluded.archived;

-- The balance of every account: its opening balance plus the effect of every live entry, computed in SQL so the accounts screen does
-- not have to load the whole ledger. Must always equal Ledger.balances() (a test holds it to that).
accountBalances:
SELECT a.id AS id,
    a.opening_minor
    + COALESCE((SELECT SUM(CASE e.kind
          WHEN 'EXPENSE' THEN -e.amount_minor
          WHEN 'INCOME' THEN e.amount_minor
          WHEN 'TRANSFER' THEN -e.amount_minor
          WHEN 'REFUND' THEN e.amount_minor
          WHEN 'SETTLEMENT' THEN CASE e.direction WHEN 'RECEIVED_FROM_PERSON' THEN e.amount_minor ELSE -e.amount_minor END
          ELSE 0 END)
       FROM entry e WHERE e.account_id = a.id AND e.deleted = 0), 0)
    + COALESCE((SELECT SUM(e.to_amount_minor) FROM entry e WHERE e.kind = 'TRANSFER' AND e.counter_account_id = a.id AND e.deleted = 0), 0) AS balance
FROM account a WHERE a.deleted = 0;

-- How much of the ledger refers to an account: entries (live or deleted), quick entries and repeating expenses.
-- Repeating items and quick entries that post to an account (archiving it would leave them pointing at a hidden account).
accountSavedItemUsage:
SELECT (SELECT COUNT(*) FROM template WHERE account_id = :id AND deleted = 0) + (SELECT COUNT(*) FROM recurring WHERE (account_id = :id OR to_account_id = :id) AND deleted = 0);

accountUsage:
SELECT (SELECT COUNT(*) FROM entry WHERE account_id = :id OR counter_account_id = :id)
     + (SELECT COUNT(*) FROM template WHERE account_id = :id AND deleted = 0)
     + (SELECT COUNT(*) FROM recurring WHERE account_id = :id AND deleted = 0);

retargetAccountCurrency:
UPDATE account SET currency = ? WHERE id = ?;

accountById:
SELECT * FROM account WHERE id = :id;

softDeleteAccount:
UPDATE account SET deleted = 1 WHERE id = ?;

selectAccounts:
SELECT * FROM account WHERE deleted = 0 ORDER BY name;

-- Upsert by id only. A clash on (source, source_ref) from a different id fails loudly instead of
-- deleting the existing row, so a re-sent SMS can never wipe an entry the user has edited.
insertEntry:
INSERT INTO entry(id, kind, occurred_at, account_id, counter_account_id, amount_minor, currency, category_id, merchant, note, source, source_ref, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0)
ON CONFLICT(id) DO UPDATE SET
    kind = excluded.kind, occurred_at = excluded.occurred_at, account_id = excluded.account_id,
    counter_account_id = excluded.counter_account_id, amount_minor = excluded.amount_minor,
    currency = excluded.currency, category_id = excluded.category_id, merchant = excluded.merchant,
    note = excluded.note, source = excluded.source, source_ref = excluded.source_ref;

-- Deletion is explicit. Upserts never change the deleted flag, so replaying an edit cannot bring back a deleted row.
softDeleteEntry:
UPDATE entry SET deleted = 1 WHERE id = ?;

restoreEntry:
UPDATE entry SET deleted = 0 WHERE id = ?;

entryCount:
SELECT COUNT(*) FROM entry WHERE deleted = 0;

recentEntries:
SELECT * FROM entry WHERE deleted = 0 ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

-- Keyset paging: pass the occurred_at and seq of the last row already shown. Unlike OFFSET, the cost does not
-- grow with how far the user has scrolled (24 ms at row 100,000 with OFFSET on an emulator, measured).
entriesBefore:
SELECT * FROM entry WHERE deleted = 0 AND (occurred_at, seq) < (:occurredAt, :seq)
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

-- Exact full-text search in date order. Two plans, chosen by the caller (see Search.kt) from countMatches:
--   searchEntries     - fetches every match, then sorts. Fast for up to ~2000 matches.
--   searchEntriesWalk - walks the date index newest first and stops after :limit hits. Fast when matches are
--                       common; scans the whole index when they are rare.
-- On an emulator with SQLCipher and 100k rows with scattered dates: 8300 matches took 70 ms with sort-first
-- and 1 ms with the walk; 1 match took 1 ms with sort-first and 25 ms with the walk.
-- :q must be a valid FTS5 expression of 3+ characters; callers quote user input as a phrase.
searchEntries:
SELECT * FROM entry
WHERE deleted = 0 AND seq IN (SELECT rowid FROM entry_fts WHERE entry_fts MATCH :q)
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

searchEntriesWalk:
SELECT * FROM entry INDEXED BY entry_time
WHERE deleted = 0 AND seq IN (SELECT rowid FROM entry_fts WHERE entry_fts MATCH :q)
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

-- Counts matches but stops at :cap, so it stays cheap for very common terms (about 2 ms for 2001).
countMatches:
SELECT COUNT(*) FROM (SELECT rowid FROM entry_fts WHERE entry_fts MATCH :q LIMIT :cap);

-- Fallback for 1-2 character queries, which the trigram index cannot answer.
searchShort:
SELECT * FROM entry
WHERE deleted = 0 AND (merchant LIKE '%' || :q || '%' OR note LIKE '%' || :q || '%')
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

spendByCategory:
SELECT category_id, SUM(mine_minor) AS mine, SUM(cash_out_minor) AS cash_out
FROM spend_line
WHERE currency = :currency AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
GROUP BY category_id;

-- Your spending grouped by something other than category. All of them count exactly the spend lines the category report counts.
spendByAccount:
SELECT e.account_id AS key, SUM(s.mine_minor) AS mine FROM spend_line s JOIN entry e ON e.id = s.entry_id
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND e.deleted = 0
GROUP BY e.account_id;

insertAttachment:
INSERT INTO attachment(id, entry_id, name, mime, size_bytes, sha256, created_at) VALUES (?, ?, ?, ?, ?, ?, ?);

attachmentsOf:
SELECT * FROM attachment WHERE entry_id = :entryId ORDER BY created_at, id;

attachmentById:
SELECT * FROM attachment WHERE id = :id;

deleteAttachment:
DELETE FROM attachment WHERE id = :id;

allAttachmentIds:
SELECT id FROM attachment;

entryBySourceRef:
SELECT id, deleted, kind FROM entry WHERE source = :source AND source_ref = :sourceRef;

allCaptureRules:
SELECT * FROM capture_rule ORDER BY position, id;

upsertCaptureRule:
INSERT INTO capture_rule(id, position, pattern, category_id) VALUES (?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET position = excluded.position, pattern = excluded.pattern, category_id = excluded.category_id;

deleteCaptureRule:
DELETE FROM capture_rule WHERE id = ?;

maxRulePosition:
SELECT COALESCE(MAX(position), 0) FROM capture_rule;

allMerchantMap:
SELECT * FROM merchant_map;

learnMerchant:
INSERT INTO merchant_map(key, category_id, uses) VALUES (?, ?, 1)
ON CONFLICT(key) DO UPDATE SET category_id = excluded.category_id, uses = CASE WHEN merchant_map.category_id = excluded.category_id THEN merchant_map.uses + 1 ELSE 1 END;

forgetMerchant:
DELETE FROM merchant_map WHERE key = ?;

-- Past entries whose payee or note mentions a word (case-insensitive): what a rule would have caught, for testing it against history.
entriesMentioning:
SELECT COUNT(*) FROM entry WHERE deleted = 0 AND kind IN ('EXPENSE', 'INCOME') AND (merchant LIKE '%' || :word || '%' ESCAPE '\' OR note LIKE '%' || :word || '%' ESCAPE '\');

-- Entries a captured debit might be: same amount going out (an expense, or a transfer out), in a window of time.
entriesNearDebit:
SELECT id, occurred_at, source_ref, merchant FROM entry
WHERE deleted = 0 AND kind IN ('EXPENSE', 'TRANSFER') AND amount_minor = :amount AND occurred_at >= :fromMillis AND occurred_at < :untilMillis;

-- Entries a captured credit might be: the same amount coming in (income, a refund, or a transfer in).
entriesNearCredit:
SELECT id, occurred_at, source_ref, merchant FROM entry
WHERE deleted = 0 AND kind IN ('INCOME', 'REFUND') AND amount_minor = :amount AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
UNION ALL
SELECT id, occurred_at, source_ref, merchant FROM entry
WHERE deleted = 0 AND kind = 'TRANSFER' AND to_amount_minor = :amount AND occurred_at >= :fromMillis AND occurred_at < :untilMillis;

-- The entries carrying a bank reference, whatever their date and amount: the same reference is the same transaction.
entriesWithReference:
SELECT id, occurred_at, source_ref, merchant, amount_minor, kind FROM entry WHERE deleted = 0 AND source_ref = :ref COLLATE NOCASE;

-- Expenses a refund of :amount could be for: at least that much, in a window before it, best amount match first, then nearest.
refundCandidates:
SELECT id, merchant, note, amount_minor, occurred_at FROM entry
WHERE deleted = 0 AND kind = 'EXPENSE' AND amount_minor >= :amount AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
ORDER BY (amount_minor = :amount) DESC, occurred_at DESC LIMIT 8;

-- Entries from another source (a text, a notification, typed by hand) that a statement row might be: same account, kind and amount, in a window.
entriesLikeStatementRow:
SELECT id FROM entry WHERE deleted = 0 AND account_id = :account AND kind = :kind AND amount_minor = :amount
  AND occurred_at >= :fromMillis AND occurred_at < :untilMillis AND (source IS NULL OR source <> 'csv');

flipInboxDirection:
UPDATE inbox SET direction = CASE direction WHEN 'DEBIT' THEN 'CREDIT' WHEN 'CREDIT' THEN 'DEBIT' ELSE direction END WHERE id = ? AND status = 'PENDING';

livePeople:
SELECT * FROM person WHERE deleted = 0 ORDER BY name COLLATE NOCASE, id;

allPeople:
SELECT * FROM person;

personById:
SELECT * FROM person WHERE id = ?;

insertPerson:
INSERT INTO person(id, name, deleted) VALUES (?, ?, 0);

insertPersonRaw:
INSERT OR IGNORE INTO person(id, name, deleted) VALUES (?, ?, ?);

removePerson:
UPDATE person SET deleted = 1 WHERE id = ?;

personUsage:
SELECT COUNT(*) FROM entry WHERE person_id = ?;

-- What each person owes (positive) or is owed (negative), from the settlements with them: money the person gave minus money the person got.
loanBalances:
SELECT person_id, SUM(CASE direction WHEN 'PAID_TO_PERSON' THEN amount_minor WHEN 'RECEIVED_FROM_PERSON' THEN -amount_minor ELSE 0 END) AS balance,
    COUNT(*) AS n, MAX(occurred_at) AS last_at
FROM entry WHERE kind = 'SETTLEMENT' AND deleted = 0 AND currency = ? AND person_id IS NOT NULL
GROUP BY person_id;

loanEntriesOfPerson:
SELECT * FROM entry WHERE kind = 'SETTLEMENT' AND person_id = ? AND deleted = 0 ORDER BY occurred_at DESC, seq DESC;

inboxSameTextNear:
SELECT COUNT(*) FROM inbox WHERE source = ? AND sender = ? AND body = ? AND received_at BETWEEN ? AND ?;

insertInbox:
INSERT OR IGNORE INTO inbox(id, source, sender, issuer, received_at, direction, amount_minor, currency, txn_date, reference, account_last4, via_upi, confidence, body, fingerprint)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertBill:
INSERT OR IGNORE INTO bill(id, source, sender, issuer, kind, title, amount_minor, min_due_minor, currency, due_date, account_last4, reference, auto_debit, received_at, body, status, entry_id, paid_at, dedupe_key)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

billById:
SELECT * FROM bill WHERE id = ?;

billsByStatus:
SELECT * FROM bill WHERE status = :status ORDER BY due_date IS NULL, due_date, received_at DESC, id LIMIT :limit;

billCount:
SELECT COUNT(*) FROM bill WHERE status = ?;

allBills:
SELECT * FROM bill;

moveBill:
UPDATE bill SET status = :to, body = NULL WHERE id = :id AND status = :from;

payBill:
UPDATE bill SET status = 'PAID', entry_id = :entryId, paid_at = :at, body = NULL WHERE id = :id AND status IN ('FOUND', 'TRACKED');

unpayBill:
UPDATE bill SET status = 'TRACKED', entry_id = NULL, paid_at = NULL WHERE id = ? AND status = 'PAID';

-- A bill marked paid by an entry that has since been deleted is not paid: back to being tracked.
releaseBillsOfRemovedEntries:
UPDATE bill SET status = 'TRACKED', entry_id = NULL, paid_at = NULL
WHERE status = 'PAID' AND entry_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM entry WHERE entry.id = bill.entry_id AND entry.deleted = 0);

setBillDue:
UPDATE bill SET due_date = :due WHERE id = :id AND status IN ('FOUND', 'TRACKED');

inboxPendingTotals:
SELECT COALESCE(SUM(CASE WHEN direction = 'CREDIT' THEN 0 ELSE amount_minor END), 0) AS money_out, COALESCE(SUM(CASE WHEN direction = 'CREDIT' THEN amount_minor ELSE 0 END), 0) AS money_in
FROM inbox WHERE status = 'PENDING';

inboxByStatus:
SELECT * FROM inbox WHERE status = :status ORDER BY received_at DESC, id LIMIT :limit;

inboxById:
SELECT * FROM inbox WHERE id = :id;

inboxCount:
SELECT COUNT(*) FROM inbox WHERE status = :status;

resolveInbox:
UPDATE inbox SET status = :status, entry_id = :entryId, body = NULL WHERE id = :id AND status = 'PENDING';

reopenInbox:
UPDATE inbox SET status = 'PENDING', entry_id = NULL WHERE id = :id AND status != 'PENDING';

insertCaptureEvent:
INSERT INTO capture_event(at, sender_root, outcome) VALUES (?, ?, ?);

pruneCaptureEvents:
DELETE FROM capture_event WHERE at < :before;

captureEventCounts:
SELECT sender_root, outcome, COUNT(*) AS n, MAX(at) AS last_at FROM capture_event WHERE at >= :since GROUP BY sender_root, outcome;

upsertCardTerms:
INSERT INTO card_terms(account_id, statement_day, due_day, min_due_percent, remind_days) VALUES (?, ?, ?, ?, ?)
ON CONFLICT(account_id) DO UPDATE SET statement_day = excluded.statement_day, due_day = excluded.due_day, min_due_percent = excluded.min_due_percent, remind_days = excluded.remind_days;

cardTermsOf:
SELECT * FROM card_terms WHERE account_id = :id;

allCardTerms:
SELECT t.* FROM card_terms t JOIN account a ON a.id = t.account_id WHERE a.deleted = 0 AND a.type = 'CREDIT_CARD' ORDER BY a.name;

deleteCardTerms:
DELETE FROM card_terms WHERE account_id = :id;

-- What an account held at a moment: the same sum as accountBalances, limited to entries before :untilMillis (an exclusive end).
accountBalanceBefore:
SELECT a.opening_minor
    + COALESCE((SELECT SUM(CASE e.kind
          WHEN 'EXPENSE' THEN -e.amount_minor
          WHEN 'INCOME' THEN e.amount_minor
          WHEN 'TRANSFER' THEN -e.amount_minor
          WHEN 'REFUND' THEN e.amount_minor
          WHEN 'SETTLEMENT' THEN CASE e.direction WHEN 'RECEIVED_FROM_PERSON' THEN e.amount_minor ELSE -e.amount_minor END
          ELSE 0 END)
       FROM entry e WHERE e.account_id = a.id AND e.deleted = 0 AND e.occurred_at < :untilMillis), 0)
    + COALESCE((SELECT SUM(e.to_amount_minor) FROM entry e WHERE e.kind = 'TRANSFER' AND e.counter_account_id = a.id AND e.deleted = 0 AND e.occurred_at < :untilMillis), 0) AS balance
FROM account a WHERE a.id = :id;

-- Money that came into an account from :fromMillis on: income, refunds and transfers in (what pays down a card).
accountInflowSince:
SELECT COALESCE((SELECT SUM(e.amount_minor) FROM entry e WHERE e.account_id = :id AND e.kind IN ('INCOME', 'REFUND') AND e.deleted = 0 AND e.occurred_at >= :fromMillis), 0)
     + COALESCE((SELECT SUM(e.to_amount_minor) FROM entry e WHERE e.kind = 'TRANSFER' AND e.counter_account_id = :id AND e.deleted = 0 AND e.occurred_at >= :fromMillis), 0);

upsertSavedSearch:
INSERT INTO saved_search(id, name, text, min_rupees, max_rupees, category_id, kind, range_kind, tag, deleted) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0)
ON CONFLICT(id) DO UPDATE SET name = excluded.name, text = excluded.text, min_rupees = excluded.min_rupees, max_rupees = excluded.max_rupees,
    category_id = excluded.category_id, kind = excluded.kind, range_kind = excluded.range_kind, tag = excluded.tag;

liveSavedSearches:
SELECT * FROM saved_search WHERE deleted = 0 ORDER BY name COLLATE NOCASE;

savedSearchById:
SELECT * FROM saved_search WHERE id = :id;

softDeleteSavedSearch:
UPDATE saved_search SET deleted = 1 WHERE id = ?;

-- A refund counts with the purchase it reverses (its merchant and its tags), but under its own account.
-- An entry with several tags counts under each of them, so these rows can add up to more than the total.
spendByTag:
SELECT t.tag AS key, SUM(s.mine_minor) AS mine FROM spend_line s JOIN entry e ON e.id = s.entry_id JOIN entry_tag t ON t.entry_id = COALESCE(e.refunds_entry, e.id)
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND e.deleted = 0
GROUP BY t.tag COLLATE NOCASE;

spendUntagged:
SELECT COALESCE(SUM(s.mine_minor), 0) FROM spend_line s JOIN entry e ON e.id = s.entry_id
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND e.deleted = 0
  AND NOT EXISTS (SELECT 1 FROM entry_tag t WHERE t.entry_id = COALESCE(e.refunds_entry, e.id));

-- By merchant exactly as typed, ignoring case and spaces at the ends. No merchant is the empty key.
spendByMerchant:
SELECT lower(trim(coalesce(o.merchant, e.merchant, ''))) AS key, MAX(coalesce(o.merchant, e.merchant)) AS display, SUM(s.mine_minor) AS mine
FROM spend_line s JOIN entry e ON e.id = s.entry_id LEFT JOIN entry o ON o.id = e.refunds_entry
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND e.deleted = 0
GROUP BY lower(trim(coalesce(o.merchant, e.merchant, '')));

-- The entries behind one of those rows. Each filter is optional; :untagged keeps only entries with no tag.
drillGrouped:
SELECT e.id AS entry_id, e.kind AS kind, e.merchant AS merchant, e.note AS note, s.occurred_at AS occurred_at,
       SUM(s.mine_minor) AS mine, MIN(s.category_id) AS category_id
FROM spend_line s JOIN entry e ON e.id = s.entry_id LEFT JOIN entry o ON o.id = e.refunds_entry
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND e.deleted = 0
  AND (:account IS NULL OR e.account_id = :account)
  AND (:tag IS NULL OR EXISTS (SELECT 1 FROM entry_tag t WHERE t.entry_id = COALESCE(e.refunds_entry, e.id) AND t.tag = :tag))
  AND (:merchantKey IS NULL OR lower(trim(coalesce(o.merchant, e.merchant, ''))) = :merchantKey)
  AND (:untagged = 0 OR NOT EXISTS (SELECT 1 FROM entry_tag t WHERE t.entry_id = COALESCE(e.refunds_entry, e.id)))
GROUP BY e.id
ORDER BY s.occurred_at DESC, e.seq DESC
LIMIT :limit;

-- What was spent and when, for the calendar: the covering index answers it without touching entries.
spendPointsBetween:
SELECT occurred_at, mine_minor FROM spend_line
WHERE currency = :currency AND occurred_at >= :fromMillis AND occurred_at < :untilMillis;

insertSpendLine:
INSERT INTO spend_line(entry_id, line, occurred_at, currency, category_id, mine_minor, cash_out_minor) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSpendLines:
DELETE FROM spend_line WHERE entry_id = ?;

-- Full entry upsert used by the repository. Like insertEntry it never touches the deleted flag.
upsertEntryFull:
INSERT INTO entry(id, kind, occurred_at, account_id, counter_account_id, amount_minor, currency, category_id,
                  person_id, to_amount_minor, to_currency, direction, refunds_entry, original_amount_minor, original_currency,
                  merchant, note, source, source_ref, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0)
ON CONFLICT(id) DO UPDATE SET
    kind = excluded.kind, occurred_at = excluded.occurred_at, account_id = excluded.account_id,
    counter_account_id = excluded.counter_account_id, amount_minor = excluded.amount_minor,
    currency = excluded.currency, category_id = excluded.category_id, person_id = excluded.person_id,
    to_amount_minor = excluded.to_amount_minor, to_currency = excluded.to_currency, direction = excluded.direction,
    refunds_entry = excluded.refunds_entry, original_amount_minor = excluded.original_amount_minor,
    original_currency = excluded.original_currency, merchant = excluded.merchant, note = excluded.note,
    source = excluded.source, source_ref = excluded.source_ref;

entryById:
SELECT * FROM entry WHERE id = :id;

liveEntriesInInsertionOrder:
SELECT * FROM entry WHERE deleted = 0 ORDER BY seq;

refundsOf:
SELECT * FROM entry WHERE kind = 'REFUND' AND refunds_entry = :expenseId AND deleted = 0 ORDER BY seq;

-- What other live refunds already take from an expense (the one being edited is left out).
refundedExcept:
SELECT COALESCE(SUM(amount_minor), 0) FROM entry WHERE kind = 'REFUND' AND refunds_entry = :expenseId AND deleted = 0 AND id <> :exceptId;

hasLiveRefunds:
SELECT EXISTS(SELECT 1 FROM entry WHERE kind = 'REFUND' AND refunds_entry = :expenseId AND deleted = 0);

-- The first (main) category of each of the given entries, for showing a category on list rows.
firstSplits:
SELECT entry_id, category_id FROM entry_split WHERE position = 0 AND entry_id IN :ids;

insertSplit:
INSERT INTO entry_split(entry_id, position, category_id, amount_minor) VALUES (?, ?, ?, ?);

deleteSplits:
DELETE FROM entry_split WHERE entry_id = ?;

splitsOf:
SELECT * FROM entry_split WHERE entry_id = :entryId ORDER BY position;

allSplits:
SELECT * FROM entry_split ORDER BY entry_id, position;

insertShare:
INSERT INTO entry_share(entry_id, position, person_id, amount_minor) VALUES (?, ?, ?, ?);

deleteShares:
DELETE FROM entry_share WHERE entry_id = ?;

sharesOf:
SELECT * FROM entry_share WHERE entry_id = :entryId ORDER BY position;

allShares:
SELECT * FROM entry_share ORDER BY entry_id, position;

tagsOf:
SELECT tag FROM entry_tag WHERE entry_id = :entryId ORDER BY tag COLLATE NOCASE;

deleteTags:
DELETE FROM entry_tag WHERE entry_id = :entryId;

insertTag:
INSERT OR IGNORE INTO entry_tag(entry_id, tag) VALUES (?, ?);

-- The spelling already in use for a tag, if any.
tagSpelling:
SELECT tag FROM entry_tag WHERE tag = :tag LIMIT 1;

allEntryTags:
SELECT entry_id, tag FROM entry_tag ORDER BY entry_id, tag COLLATE NOCASE;

-- How many entries carry each tag, deleted entries included: one pass over the tag index, which covers it (no entry rows are read).
-- The joined form (live entries only, grouped) read every tagged entry's row and took about 700 ms on 33,000 tagged entries.
tagCountsAll:
SELECT tag, COUNT(*) AS uses FROM entry_tag GROUP BY tag COLLATE NOCASE;

-- The same count for deleted entries only, which are few; subtracting it gives the live count.
tagCountsDeleted:
-- CROSS JOIN fixes the order: deleted entries first (a few rows from the partial index), then their tags. Left to choose, the planner
-- scanned every tag row and looked each entry up, which took 300 ms on a phone-class database.
SELECT t.tag AS tag, COUNT(*) AS uses FROM entry e CROSS JOIN entry_tag t ON t.entry_id = e.id WHERE e.deleted = 1 GROUP BY t.tag COLLATE NOCASE;

entriesWithTag:
SELECT e.* FROM entry e JOIN entry_tag t ON t.entry_id = e.id
WHERE t.tag = :tag AND e.deleted = 0 ORDER BY e.occurred_at DESC, e.seq DESC LIMIT :limit;

upsertTemplate:
INSERT INTO template(id, name, amount_minor, currency, category_id, account_id, merchant, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, 0)
ON CONFLICT(id) DO UPDATE SET name = excluded.name, amount_minor = excluded.amount_minor, currency = excluded.currency,
    category_id = excluded.category_id, account_id = excluded.account_id, merchant = excluded.merchant;

templateById:
SELECT * FROM template WHERE id = :id;

liveTemplates:
SELECT * FROM template WHERE deleted = 0 ORDER BY uses DESC, name COLLATE NOCASE, id;

softDeleteTemplate:
UPDATE template SET deleted = 1 WHERE id = ?;

bumpTemplateUse:
UPDATE template SET uses = uses + 1 WHERE id = ?;

settingValue:
SELECT value FROM setting WHERE key = :key;

putSetting:
INSERT INTO setting(key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value;

liveCategories:
SELECT * FROM category WHERE deleted = 0 ORDER BY position, name COLLATE NOCASE, id;

categoryById:
SELECT * FROM category WHERE id = :id;

insertCategory:
INSERT INTO category(id, name, parent_id, color, position, hidden, deleted) VALUES (?, ?, ?, ?, ?, 0, 0);

updateCategory:
UPDATE category SET name = :name, parent_id = :parentId, color = :color, position = :position, hidden = :hidden WHERE id = :id;

softDeleteCategory:
UPDATE category SET deleted = 1 WHERE id = :id;

markMerged:
UPDATE category SET deleted = 1, merged_into = :into WHERE id = :from;

-- The category this id was merged into, or no row if it was never merged.
mergedInto:
SELECT merged_into FROM category WHERE id = :id AND merged_into IS NOT NULL;

categoryCount:
SELECT COUNT(*) FROM category;

maxCategoryPosition:
SELECT COALESCE(MAX(position), -1) FROM category WHERE deleted = 0 AND parent_id IS :parentId;

-- Everything that refers to a category, live or not, so a category is never deleted while a deleted entry could come back.
categoryUsage:
SELECT (SELECT COUNT(*) FROM entry_split WHERE category_id = :id)
     + (SELECT COUNT(*) FROM entry WHERE category_id = :id)
     + (SELECT COUNT(*) FROM template WHERE category_id = :id AND deleted = 0)
     + (SELECT COUNT(*) FROM recurring WHERE category_id = :id AND deleted = 0);

remapSplits:
UPDATE entry_split SET category_id = :into WHERE category_id = :from;

remapSpendLines:
UPDATE spend_line SET category_id = :into WHERE category_id = :from;

remapIncome:
UPDATE entry SET category_id = :into WHERE category_id = :from;

remapTemplates:
UPDATE template SET category_id = :into WHERE category_id = :from;

insertCurrency:
INSERT OR IGNORE INTO currency(code, digits) VALUES (?, ?);

selectCurrencies:
SELECT * FROM currency;

insertOp:
INSERT INTO op_log(hlc, entity, row_id, field, value) VALUES (?, ?, ?, ?, ?);

opsSince:
SELECT * FROM op_log WHERE hlc > :hlc ORDER BY hlc LIMIT :limit;

opsOfRow:
SELECT * FROM op_log WHERE entity = :entity AND row_id = :rowId ORDER BY hlc;

latestOp:
SELECT * FROM op_log WHERE entity = :entity AND row_id = :rowId AND field = :field ORDER BY hlc DESC LIMIT 1;

allBudgets:
SELECT * FROM budget;

budgetByScope:
SELECT * FROM budget WHERE scope = :scope;

upsertBudget:
INSERT INTO budget(scope, limit_minor, currency) VALUES (?, ?, ?)
ON CONFLICT(scope) DO UPDATE SET limit_minor = excluded.limit_minor, currency = excluded.currency;

deleteBudget:
DELETE FROM budget WHERE scope = :scope;

budgetPeriod:
SELECT * FROM budget_period WHERE id = 1;

putBudgetPeriod:
INSERT INTO budget_period(id, kind, start_value) VALUES (1, ?, ?)
ON CONFLICT(id) DO UPDATE SET kind = excluded.kind, start_value = excluded.start_value;

liveRecurring:
SELECT * FROM recurring WHERE deleted = 0 ORDER BY name COLLATE NOCASE, id;

recurringById:
SELECT * FROM recurring WHERE id = :id;

upsertRecurring:
INSERT INTO recurring(id, name, amount_minor, currency, category_id, account_id, merchant, unit, every, start_day, end_kind, end_value, auto, kind, to_account_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET name = excluded.name, amount_minor = excluded.amount_minor, currency = excluded.currency,
    category_id = excluded.category_id, account_id = excluded.account_id, merchant = excluded.merchant, unit = excluded.unit,
    every = excluded.every, start_day = excluded.start_day, end_kind = excluded.end_kind, end_value = excluded.end_value, auto = excluded.auto, kind = excluded.kind, to_account_id = excluded.to_account_id;

softDeleteRecurring:
UPDATE recurring SET deleted = 1 WHERE id = :id;

remapRecurring:
UPDATE recurring SET category_id = :into WHERE category_id = :from;

doneDays:
SELECT day FROM recurring_done WHERE recurring_id = :id AND day >= :fromDay;

lastDoneDay:
SELECT MAX(day) FROM recurring_done WHERE recurring_id = :id;

doneRow:
SELECT * FROM recurring_done WHERE recurring_id = :id AND day = :day;

putDone:
INSERT INTO recurring_done(recurring_id, day, outcome, entry_id) VALUES (?, ?, ?, ?);

deleteDone:
DELETE FROM recurring_done WHERE recurring_id = :id AND day = :day;

-- Backup and restore.
replaceCategory:
UPDATE category SET name = :name, parent_id = :parentId, color = :color, position = :position, hidden = :hidden, deleted = :deleted, merged_into = :mergedInto WHERE id = :id;

allCategories:
SELECT * FROM category ORDER BY position, id;

insertCategoryRaw:
INSERT INTO category(id, name, parent_id, color, position, hidden, deleted, merged_into) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

allAccounts:
SELECT * FROM account WHERE deleted = 0 ORDER BY name, id;

allTemplates:
SELECT * FROM template WHERE deleted = 0 ORDER BY name, id;

allRecurringDone:
SELECT * FROM recurring_done ORDER BY recurring_id, day;

-- Reports. The entries behind a spending figure: one row per entry with the part of it that falls in the chosen categories.
-- Built from the same spend lines as the totals, so the rows always add up to the figure they were opened from.
drillCategories:
SELECT e.id AS entry_id, e.kind AS kind, e.merchant AS merchant, e.note AS note, s.occurred_at AS occurred_at,
       SUM(s.mine_minor) AS mine, MIN(s.category_id) AS category_id
FROM spend_line s JOIN entry e ON e.id = s.entry_id
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND s.category_id IN :ids AND e.deleted = 0
GROUP BY e.id
ORDER BY s.occurred_at DESC, e.seq DESC
LIMIT :limit;

drillUncategorised:
SELECT e.id AS entry_id, e.kind AS kind, e.merchant AS merchant, e.note AS note, s.occurred_at AS occurred_at,
       SUM(s.mine_minor) AS mine, MIN(s.category_id) AS category_id
FROM spend_line s JOIN entry e ON e.id = s.entry_id
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND s.category_id IS NULL AND e.deleted = 0
GROUP BY e.id
ORDER BY s.occurred_at DESC, e.seq DESC
LIMIT :limit;

drillAll:
SELECT e.id AS entry_id, e.kind AS kind, e.merchant AS merchant, e.note AS note, s.occurred_at AS occurred_at,
       SUM(s.mine_minor) AS mine, MIN(s.category_id) AS category_id
FROM spend_line s JOIN entry e ON e.id = s.entry_id
WHERE s.currency = :currency AND s.occurred_at >= :fromMillis AND s.occurred_at < :untilMillis AND e.deleted = 0
GROUP BY e.id
ORDER BY s.occurred_at DESC, e.seq DESC
LIMIT :limit;

incomeTotal:
SELECT COALESCE(SUM(amount_minor), 0) FROM entry
WHERE kind = 'INCOME' AND deleted = 0 AND currency = :currency AND occurred_at >= :fromMillis AND occurred_at < :untilMillis;

incomeEntries:
SELECT * FROM entry
WHERE kind = 'INCOME' AND deleted = 0 AND currency = :currency AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

-- Search with filters. A null filter means "any". :ids is only read when :filterCats is 1 (pass one dummy id otherwise).
-- Amounts are compared in minor units, so callers give :currency whenever they give an amount.
searchFilteredText:
SELECT * FROM entry
WHERE deleted = 0 AND seq IN (SELECT rowid FROM entry_fts WHERE entry_fts MATCH :q)
  AND (:short1 IS NULL OR merchant LIKE '%' || :short1 || '%' ESCAPE '\' OR note LIKE '%' || :short1 || '%' ESCAPE '\')
  AND (:short2 IS NULL OR merchant LIKE '%' || :short2 || '%' ESCAPE '\' OR note LIKE '%' || :short2 || '%' ESCAPE '\')
  AND (:currency IS NULL OR currency = :currency)
  AND (:minMinor IS NULL OR amount_minor >= :minMinor) AND (:maxMinor IS NULL OR amount_minor <= :maxMinor)
  AND (:kind IS NULL OR kind = :kind)
  AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
  AND (:filterCats = 0 OR category_id IN :ids OR EXISTS (SELECT 1 FROM entry_split s WHERE s.entry_id = entry.id AND s.category_id IN :ids))
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

searchFilteredTextWalk:
SELECT * FROM entry INDEXED BY entry_time
WHERE deleted = 0 AND seq IN (SELECT rowid FROM entry_fts WHERE entry_fts MATCH :q)
  AND (:short1 IS NULL OR merchant LIKE '%' || :short1 || '%' ESCAPE '\' OR note LIKE '%' || :short1 || '%' ESCAPE '\')
  AND (:short2 IS NULL OR merchant LIKE '%' || :short2 || '%' ESCAPE '\' OR note LIKE '%' || :short2 || '%' ESCAPE '\')
  AND (:currency IS NULL OR currency = :currency)
  AND (:minMinor IS NULL OR amount_minor >= :minMinor) AND (:maxMinor IS NULL OR amount_minor <= :maxMinor)
  AND (:kind IS NULL OR kind = :kind)
  AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
  AND (:filterCats = 0 OR category_id IN :ids OR EXISTS (SELECT 1 FROM entry_split s WHERE s.entry_id = entry.id AND s.category_id IN :ids))
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

searchFilteredShort:
SELECT * FROM entry
WHERE deleted = 0 AND (merchant LIKE '%' || :q || '%' ESCAPE '\' OR note LIKE '%' || :q || '%' ESCAPE '\')
  AND (:currency IS NULL OR currency = :currency)
  AND (:minMinor IS NULL OR amount_minor >= :minMinor) AND (:maxMinor IS NULL OR amount_minor <= :maxMinor)
  AND (:kind IS NULL OR kind = :kind)
  AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
  AND (:filterCats = 0 OR category_id IN :ids OR EXISTS (SELECT 1 FROM entry_split s WHERE s.entry_id = entry.id AND s.category_id IN :ids))
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

-- No text: the filters alone, newest first, walking the date index.
searchFilteredNoText:
SELECT * FROM entry INDEXED BY entry_time
WHERE deleted = 0
  AND (:currency IS NULL OR currency = :currency)
  AND (:minMinor IS NULL OR amount_minor >= :minMinor) AND (:maxMinor IS NULL OR amount_minor <= :maxMinor)
  AND (:kind IS NULL OR kind = :kind)
  AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
  AND (:filterCats = 0 OR category_id IN :ids OR EXISTS (SELECT 1 FROM entry_split s WHERE s.entry_id = entry.id AND s.category_id IN :ids))
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

-- The same filters as searchFilteredNoText, plus a tag (ignoring case). Text is applied by the caller on these rows.
searchTagged:
SELECT * FROM entry
WHERE deleted = 0
  AND EXISTS (SELECT 1 FROM entry_tag t WHERE t.entry_id = entry.id AND t.tag = :tag)
  AND (:currency IS NULL OR currency = :currency)
  AND (:minMinor IS NULL OR amount_minor >= :minMinor) AND (:maxMinor IS NULL OR amount_minor <= :maxMinor)
  AND (:kind IS NULL OR kind = :kind)
  AND occurred_at >= :fromMillis AND occurred_at < :untilMillis
  AND (:filterCats = 0 OR category_id IN :ids OR EXISTS (SELECT 1 FROM entry_split s WHERE s.entry_id = entry.id AND s.category_id IN :ids))
ORDER BY occurred_at DESC, seq DESC LIMIT :limit;

-- Has any entry ever been recorded, deleted ones included (1 or 0)? Answered from the first row, so it costs the same on any ledger size.
entryCountEver:
SELECT EXISTS(SELECT 1 FROM entry);
