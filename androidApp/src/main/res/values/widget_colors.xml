<resources>
    <color name="widget_surface">#FFFFFBFE</color>
    <color name="widget_container">#FFF3EDF7</color>
    <color name="widget_chip">#FFF3EDF7</color>
    <color name="widget_text">#FF1C1B1F</color>
    <color name="widget_muted">#FF49454F</color>
    <color name="widget_track">#FFE7E0EC</color>
    <color name="widget_positive">#FF0F6B41</color>
    <color name="widget_negative">#FFA21F19</color>
    <color name="widget_undo">#FFFFE9D6</color>
</resources>
